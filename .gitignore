# macOS
.DS_Store
**/.DS_Store

# Swift Package Manager / Xcode build artifacts (DO NOT COMMIT — ~220 MB)
.build/
.swiftpm/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
DerivedData/

# Compiled app bundle — rebuild with: cd "Lumia Photo Transfer" && ./build.sh
# (ARM-only + ad-hoc signed, so not portable; source is the real artifact)
Lumia Photo Transfer/Lumia Photo Transfer.app/

# Editor / OS junk
.vscode/
.idea/
*.swp

# Runtime / secret artifacts that another tool may drop in the working tree
# (e.g. a jwt_secret). NOT part of this project — never commit.
/data/

# Third-party colour profiles — not part of this project, never commit.
# (Kept as a safeguard in case a Profiles/ dir is created locally.)
Profiles/

# AI coding assistant local config (per-developer, not project config)
.claude/

# Colour Look pipeline — removed from the open-source release.
# iCloud may restore these files; keep them out of the repo.
Lumia Photo Transfer/Sources/LookKit/
Lumia Photo Transfer/Sources/lumia-look/

# Apple signing / notarization artifacts — NEVER commit.
# The private key for the Developer ID cert must stay off the repo entirely.
*.cer
*.certSigningRequest
*.p12
*.pfx
*.mobileprovision
*.key
